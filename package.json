{
  "name": "flockton-robin",
  "version": "0.1.1",
  "private": true,
  "description": "A free desktop app for thank-you stickers and package inserts: ready-made designs or your own art, in circles, squares and rectangles, for sticker sheets, cardstock or a Cricut.",
  "license": "MIT",
  "author": "Matthew Pitts",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "smoke": "node scripts/start.js --smoke",
    "test": "vitest run",
    "icon": "node scripts/build-icon.cjs",
    "dist": "electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "vitest": "5.1.1"
  },
  "build": {
    "appId": "app.flockton.robin",
    "productName": "Robin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Robin",
      "artifactName": "Robin-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Robin-Portable.${ext}"
    }
  }
}
